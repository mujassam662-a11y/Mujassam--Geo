# Mujassam GEO system configuration. Placeholders only. Copy to .env and fill in.
# NEVER commit .env. Values are never printed by the system (they are redacted).

GEO_DB_PATH=var/geo.sqlite3
GEO_SITE_URL=https://mujassam.net/
GEO_USER_AGENT=MujassamGEOAudit/1.0 (+https://mujassam.net/contact)
GEO_CRAWL_MAX_PAGES=200
GEO_CRAWL_DELAY_SECONDS=2

# --- Google (GA4 Data API + Search Console API) ---
# Option A: path to a service-account JSON key (requires `pip install google-auth`).
#           Add the service-account email as a Viewer on the GA4 property and as a user on the GSC property.
GOOGLE_APPLICATION_CREDENTIALS=
# Option B: a short-lived OAuth access token with the scopes below (for manual runs).
GOOGLE_ACCESS_TOKEN=
GA4_PROPERTY_ID=
GSC_SITE_URL=sc-domain:mujassam.net

# --- Microsoft Clarity Data Export API ---
CLARITY_API_TOKEN=
CLARITY_PROJECT_ID=

# --- Bing Webmaster Tools API ---
BING_WEBMASTER_API_KEY=
BING_SITE_URL=https://mujassam.net/

# --- Optional AI-visibility API proxies (NOT the consumer products; labelled as api_proxy) ---
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=

# --- Email (sending is disabled in code unless BOTH flags below are set AND identity is VERIFIED_MUJASSAM) ---
GEO_EMAIL_SENDING_ENABLED=false
GEO_EMAIL_SENDING_AUTHORIZED_BY=
GEO_CONNECTED_EMAIL_ACCOUNTS=
